[Unit]
Description=Power Monitor Collector (CPU energy logging)
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/power-monitor-collector
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=power-monitor

# Shared data dir so root collector and user CLI use the same database
Environment=POWER_MONITOR_DATA_DIR=/var/lib/power-monitor
# Optional: set your tariff
# Environment=POWER_MONITOR_COST_PER_KWH=0.27

# Must run as root for RAPL/powercap sysfs access on Linux
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/power-monitor
ReadOnlyPaths=/sys/class/powercap /sys/class/hwmon
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
